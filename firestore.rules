                                 'userId', 'windowStartEpochMs', 'requestCount',
                                 'lastAction', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'userId', 'windowStartEpochMs', 'requestCount',
                                 'lastAction', 'updatedAt'
                               ]) &&
                               isValidRateLimitRecord(incoming());

      allow delete: if false;
    }

    // 21. Collection 17: studio_admins (Apex Dynamics Game Studios Administrator Directory)
    match /studio_admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 22. Collection 18: reward_configs (Server-Controlled Reward Tables, Admin-Only Write)
    match /reward_configs/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn() && existing().holeCompletionBaseCoins >= 0;

      allow create, update: if isAdmin() &&
                               isValidId(configId) &&
                               incoming().configId == configId &&
                               incoming().keys().hasAll([
                                 'configId', 'holeCompletionBaseCoins', 'birdieBonusCoins',
                                 'eagleBonusCoins', 'aceBonusCoins', 'tournamentFirstRatio',
                                 'tournamentSecondRatio', 'tournamentThirdRatio',
                                 'updatedBy', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'configId', 'holeCompletionBaseCoins', 'birdieBonusCoins',
                                 'eagleBonusCoins', 'aceBonusCoins', 'tournamentFirstRatio',
                                 'tournamentSecondRatio', 'tournamentThirdRatio',
                                 'updatedBy', 'updatedAt'
                               ]) &&
                               isValidRewardConfig(incoming());

      allow delete: if false;
    }

    // 23. Collection 19: published_challenges (Studio-Published Challenges, Admin-Only Write)
    match /published_challenges/{challengeId} {
      allow get: if isSignedIn() && isValidId(challengeId);
      allow list: if isSignedIn() && existing().rewardCoins >= 0;

      allow create, update: if isAdmin() &&
                               isValidId(challengeId) &&
                               incoming().challengeId == challengeId &&
                               incoming().keys().hasAll([
                                 'challengeId', 'title', 'description', 'targetType',
                                 'targetGoal', 'rewardCoins', 'rewardMulligans',
                                 'isActive', 'publishedBy', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'challengeId', 'title', 'description', 'targetType',
                                 'targetGoal', 'rewardCoins', 'rewardMulligans',
                                 'isActive', 'publishedBy', 'updatedAt'
                               ]) &&
                               isValidPublishedChallenge(incoming());

      allow delete: if false;
    }
  }
}
